{
    "tasks": [
        {
            "type": "shell",
            "label": "HeliOS Unit Test (build/gcc)",
            "command": "make",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}/test"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "HeliOS Unit Test (run/make test)",
            "command": "make",
            "args": ["test"],
            "options": {
                "cwd": "${workspaceFolder}/test"
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "HeliOS Uncrustify",
            "command": "find drivers src test \\( -name \"*.c\" -o -name \"*.h\" \\) -exec uncrustify -c extras/uncrustify/helios.cfg -lC --no-backup {} +",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}